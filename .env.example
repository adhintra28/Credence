# ── Google OAuth 2.0 — local development credentials ──────────────
# Copy this file to .env (git-ignored) OR set the same variables in your
# deploy platform (Render/Railway). Every line below is a comment until you
# replace the values.

# 1) Google Cloud project -> OAuth Client ID (Web application) -> paste here:
GOOGLE_CLIENT_ID=

# 2) Google Cloud -> same client -> Client secret:
GOOGLE_CLIENT_SECRET=

# 3) The EXACT redirect URI registered in the Google console:
#    local dev
OAUTH_REDIRECT_URI=http://127.0.0.1:5000/auth/callback
#    deployed (Render/Railway, https!) — uncomment and set when deployed:
# OAUTH_REDIRECT_URI=https://credence-predelinquency.onrender.com/auth/callback

# 4) Session signing secret (any long random string):
PREDELINQ_SECRET=change-me-to-a-long-random-string

# Full walkthrough: docs/SSO_SETUP.md
